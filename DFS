#include <iostream>
using namespace std;

void DFS(int graph[10][10], bool visited[10], int vertex, int n)
{
    cout << vertex << " ";
    visited[vertex] = true;

    for (int i = 0; i < n; i++)
    {
        if (graph[vertex][i] == 1 && !visited[i])
        {
            DFS(graph, visited, i, n);
        }
    }
}

int main()
{
    int n, graph[10][10], start;
    bool visited[10] = {false};

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix:\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> graph[i][j];

    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "DFS Traversal: ";
    DFS(graph, visited, start, n);

    return 0;
}



